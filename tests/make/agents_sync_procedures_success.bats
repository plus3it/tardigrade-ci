#!/usr/bin/env bats

TEST_DIR="$(pwd)/agents_sync_procedures_success"
REPO_ROOT="$(cd "$(dirname "${BATS_TEST_FILENAME}")/../.." && pwd)"
TEMPLATE_DIR="$TEST_DIR/template"
WORK_DIR="$TEST_DIR/work"
PIN_FILE=".github/workflows/dependabot_hack.yml"

function setup() {
  rm -rf "$TEST_DIR"
  mkdir -p "$TEMPLATE_DIR/agents/procedures" "$WORK_DIR/.github/workflows"
  echo "# Stacks" > "$TEMPLATE_DIR/agents/procedures/stacks.md"
  echo "# Roots" > "$TEMPLATE_DIR/agents/procedures/roots.md"
  git -C "$TEMPLATE_DIR" init -q
  git -C "$TEMPLATE_DIR" add .
  git -C "$TEMPLATE_DIR" -c user.name=test -c user.email=test@example.com commit -q -m "procedures"
  git -C "$TEMPLATE_DIR" tag 1.2.3
  echo "      - uses: plus3it/tardigrade@1.2.3" > "$WORK_DIR/$PIN_FILE"
}

@test "agents/sync: no pin file writes no procedures" {
  rm "$WORK_DIR/$PIN_FILE"
  run bash -c "cd '$WORK_DIR' && make -f '$REPO_ROOT/Makefile' agents/sync TARDIGRADE_CI_PATH='$REPO_ROOT' AGENTS_PROFILE=tardigrade-deployment TARDIGRADE_PATH='$TEMPLATE_DIR'"
  [ "$status" -eq 0 ]
  [ -f "$WORK_DIR/.agents/plus3it/AGENTS.md" ]
  [ ! -e "$WORK_DIR/.agents/plus3it/tardigrade" ]
  head -n 1 "$WORK_DIR/.agents/plus3it/AGENTS.md" | grep -qx '<!-- Generated by make agents/sync from tardigrade-ci .*; do not edit -->'
  ! head -n 1 "$WORK_DIR/.agents/plus3it/AGENTS.md" | grep -q "tardigrade template"
}

@test "agents/sync: pin file without a tardigrade pin writes no procedures" {
  echo "      - uses: actions/checkout@v4" > "$WORK_DIR/$PIN_FILE"
  run bash -c "cd '$WORK_DIR' && make -f '$REPO_ROOT/Makefile' agents/sync TARDIGRADE_CI_PATH='$REPO_ROOT' AGENTS_PROFILE=tardigrade-deployment TARDIGRADE_PATH='$TEMPLATE_DIR'"
  [ "$status" -eq 0 ]
  [ ! -e "$WORK_DIR/.agents/plus3it/tardigrade" ]
}

@test "agents/sync: pin with TARDIGRADE_PATH copies procedures" {
  run bash -c "cd '$WORK_DIR' && make -f '$REPO_ROOT/Makefile' agents/sync TARDIGRADE_CI_PATH='$REPO_ROOT' AGENTS_PROFILE=tardigrade-deployment TARDIGRADE_PATH='$TEMPLATE_DIR'"
  [ "$status" -eq 0 ]
  [ "$(cat "$WORK_DIR/.agents/plus3it/tardigrade/stacks.md")" = "# Stacks" ]
  [ "$(cat "$WORK_DIR/.agents/plus3it/tardigrade/roots.md")" = "# Roots" ]
  head -n 1 "$WORK_DIR/.agents/plus3it/AGENTS.md" | grep -q "; tardigrade template 1.2.3; do not edit -->"
  [ "$(cat "$WORK_DIR/.agents/plus3it/.gitignore")" = "*" ]
}

@test "agents/sync: pin downloads the tagged template" {
  run bash -c "cd '$WORK_DIR' && make -f '$REPO_ROOT/Makefile' agents/sync TARDIGRADE_CI_PATH='$REPO_ROOT' AGENTS_PROFILE=tardigrade-deployment TARDIGRADE_GIT_URL='$TEMPLATE_DIR'"
  [ "$status" -eq 0 ]
  [ "$(cat "$WORK_DIR/.agents/plus3it/tardigrade/stacks.md")" = "# Stacks" ]
  [ "$(cat "$WORK_DIR/.agents/plus3it/tardigrade/roots.md")" = "# Roots" ]
  head -n 1 "$WORK_DIR/.agents/plus3it/AGENTS.md" | grep -q "tardigrade template 1.2.3"
}

@test "agents/sync: a custom TARDIGRADE_REF_FILE is read" {
  mv "$WORK_DIR/$PIN_FILE" "$WORK_DIR/pin.txt"
  run bash -c "cd '$WORK_DIR' && make -f '$REPO_ROOT/Makefile' agents/sync TARDIGRADE_CI_PATH='$REPO_ROOT' AGENTS_PROFILE=tardigrade-deployment TARDIGRADE_REF_FILE=pin.txt TARDIGRADE_GIT_URL='$TEMPLATE_DIR'"
  [ "$status" -eq 0 ]
  [ -f "$WORK_DIR/.agents/plus3it/tardigrade/stacks.md" ]
}

@test "agents/sync: pin is ignored for other profiles" {
  run bash -c "cd '$WORK_DIR' && make -f '$REPO_ROOT/Makefile' agents/sync TARDIGRADE_CI_PATH='$REPO_ROOT' AGENTS_PROFILE=terraform-module TARDIGRADE_PATH='$TEMPLATE_DIR'"
  [ "$status" -eq 0 ]
  [ -f "$WORK_DIR/.agents/plus3it/AGENTS.md" ]
  [ ! -e "$WORK_DIR/.agents/plus3it/tardigrade" ]
  ! head -n 1 "$WORK_DIR/.agents/plus3it/AGENTS.md" | grep -q "tardigrade template"
}

@test "agents/sync: re-sync removes procedures deleted from the source" {
  run bash -c "cd '$WORK_DIR' && make -f '$REPO_ROOT/Makefile' agents/sync TARDIGRADE_CI_PATH='$REPO_ROOT' AGENTS_PROFILE=tardigrade-deployment TARDIGRADE_PATH='$TEMPLATE_DIR'"
  [ "$status" -eq 0 ]
  [ -f "$WORK_DIR/.agents/plus3it/tardigrade/roots.md" ]
  rm "$TEMPLATE_DIR/agents/procedures/roots.md"
  run bash -c "cd '$WORK_DIR' && make -f '$REPO_ROOT/Makefile' agents/sync TARDIGRADE_CI_PATH='$REPO_ROOT' AGENTS_PROFILE=tardigrade-deployment TARDIGRADE_PATH='$TEMPLATE_DIR'"
  [ "$status" -eq 0 ]
  [ -f "$WORK_DIR/.agents/plus3it/tardigrade/stacks.md" ]
  [ ! -e "$WORK_DIR/.agents/plus3it/tardigrade/roots.md" ]
}

function teardown() {
  rm -rf "$TEST_DIR"
}
