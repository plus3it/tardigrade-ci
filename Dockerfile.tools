# This Dockerfile is used to let Dependabot manage pinned versions of tools that
# will be installed using the target `make install`

# Keep these sorted alphabetically, separated by an empty line

FROM bats/bats:1.14.0 as bats

FROM hashicorp/packer:1.16.0 as packer

FROM hashicorp/terraform:1.15.9 as terraform

FROM koalaman/shellcheck:v0.11.0 as shellcheck

FROM localstack/localstack:4.14.0 as localstack

FROM mikefarah/yq:4.53.6 as yq

FROM motoserver/moto:5.2.2 as moto

FROM mstruebing/editorconfig-checker:v3.11.1 as ec

FROM quay.io/terraform-docs/terraform-docs:0.20.0 as tfdocs

FROM rclone/rclone:1.75.0 as rclone
